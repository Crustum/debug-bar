{
    "name": "crustum/debug-bar",
    "description": "DebugBar plugin for CakePHP",
    "type": "cakephp-plugin",
    "license": "MIT",
    "keywords": [
        "cakephp",
        "crustum",
        "debug-bar"
    ],
    "authors": [
        {
            "name": "Evgeny Tomenko",
            "homepage": "https://github.com/skie"
        }
    ],
    "require": {
        "php": ">=8.5",
        "cakephp/cakephp": "6.x-dev",
        "composer/composer": "^2.8",
        "doctrine/sql-formatter": "^1.1.3"
    },
    "require-dev": {
        "cakephp/authentication": "5.x-dev",
        "cakephp/authorization": "4.x-dev",
        "cakedc/cakephp-phpstan": "5.next-cake6-dev",
        "cakephp/cakephp-codesniffer": "6.x-dev",
        "crustum/plugin-manifest": "2.x-dev",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^12.5 | ^13.0",
        "rector/rector": "^2.7"
    },
    "suggest": {
        "_crustum/mcp": "^2.x-dev",
        "crustum/mcp": "Local STDIO MCP server with bounded diagnostic tools",
        "crustum/plugin-manifest": "CakePHP plugin installer",
        "crustum/cakephp-attribute-resolver": "Attributes inspection panel (optional)"
    },
    "autoload": {
        "psr-4": {
            "Crustum\\DebugBar\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Crustum\\DebugBar\\Test\\": "tests/",
            "DebugBarTestPlugin\\": "tests/TestApp/Plugin/DebugBarTestPlugin/src/",
            "TestApp\\": "tests/TestApp/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@rector-check",
            "@test",
            "@analyse"
        ],
        "fix": [
            "@cs-fix",
            "@rector-fix",
            "@cs-fix",
            "@analyse"
        ],
        "analyse": [
            "@stan"
        ],
        "cs-check": "phpcs -p --standard=phpcs.xml src/ tests/",
        "cs-fix": "phpcbf --standard=phpcs.xml src/ tests/",
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=Unit",
        "test:integration": "phpunit --testsuite=Integration",
        "rector-check": "vendor/bin/rector process --dry-run",
        "rector-fix": "vendor/bin/rector process",
        "stan": "phpstan analyse src/",
        "stan-baseline": "phpstan analyse --generate-baseline"
    },
    "extra": {
        "installer-name": "DebugBar"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "cakephp/plugin-installer": true,
            "php-http/discovery": false
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
